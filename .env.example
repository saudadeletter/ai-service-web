# Run npm run setup to generate local database and admin credentials.
POSTGRES_PASSWORD=
DATABASE_URL=
APP_URL=http://localhost:3000
ADMIN_USERNAME=admin
# Format: scrypt:<32-char hex salt>:<128-char hex digest>. Generated by setup.
ADMIN_PASSWORD_HASH=
RATE_LIMIT_SECRET=
# Enable only behind a trusted Nginx that overwrites X-Real-IP.
TRUST_PROXY=false
# Public filing number; takes effect after rebuilding.
NEXT_PUBLIC_ICP_NUMBER=

# Database connection pool (1–20; default 5)
DATABASE_POOL_SIZE=5
